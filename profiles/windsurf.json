{
  "schema_version": 1,
  "id": "windsurf",
  "display_name": "ウィンドサーフィン",
  "equipment_detector": "none",
  "equipment_detector_params": {},
  "cv": {
    "blur_threshold": 120.0,
    "dark_threshold": 70.0,
    "min_width": 1280,
    "min_height": 720,
    "similarity_threshold": 10,
    "frame_interval": 1.0
  },
  "segment": {
    "enter": 0.55,
    "exit": 0.5,
    "smooth_window": 3,
    "split_gap": 2.0,
    "pre_roll": 1.0,
    "post_roll": 1.0
  },
  "paths": {
    "dataset": "dataset/windsurf/labels.csv",
    "model": "models/windsurf/frame_scorer.pkl"
  }
}
