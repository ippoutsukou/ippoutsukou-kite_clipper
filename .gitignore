.venv/
__pycache__/
*.py[cod]
backup/

# 入力データと生成物はコミットしない
input/photos/*
input/videos/*
review/photos/*
review/frames/*
selected_photos/*
selected_frames/*
logs/*

# 空フォルダだけは保持する
!input/photos/.gitkeep
!input/videos/.gitkeep
!review/photos/.gitkeep
!review/frames/.gitkeep
!selected_photos/.gitkeep
!selected_frames/.gitkeep
!logs/.gitkeep

# ローカル設定・機密情報
.env
.env.*
*.pem
*.key
secrets/
credentials/
