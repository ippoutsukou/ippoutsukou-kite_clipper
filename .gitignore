.venv/
__pycache__/
*.py[cod]
backup/
build/
dist/
# PyInstaller が自動生成する .spec は除外するが、手で調整した配布用ビルド設定は
# リポジトリで管理する（失うとビルド手順を復元できないため）
*.spec
!kite_clipper_gui.spec
!kite_clipper.spec
*.bak
作業ログ.txt

# 配布用の同梱バイナリ・モデルはリポジトリに含めない（Releasesのzipで配布）
vendor/

# 入力データと生成物はコミットしない
input/photos/*
input/videos/*
review/photos/*
review/frames/*
selected_photos/*
selected_frames/*
selected_clips/*
final/*
work/*
logs/*
# 実行結果・検証用の出力（APKは1本約200MBでGitHubの上限を超える）
out/
output/
*.apk
flutter_app/*.log

# 空フォルダだけは保持する
!input/photos/.gitkeep
!input/videos/.gitkeep
!review/photos/.gitkeep
!review/frames/.gitkeep
!selected_photos/.gitkeep
!selected_frames/.gitkeep
!selected_clips/.gitkeep
!final/.gitkeep
!work/.gitkeep
!logs/.gitkeep

# ローカル設定・機密情報
.env
.env.*
*.pem
*.key
secrets/
credentials/
/dataset/
/models/
